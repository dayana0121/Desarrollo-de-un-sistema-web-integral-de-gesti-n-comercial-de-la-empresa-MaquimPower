@{
    ViewData["Title"] = "Compras";
}

<div class="terceros-page">

    <div class="terceros-header">
        <h1>Compras</h1>
        <p>Gestione órdenes de compra, proveedores y recepción de mercadería</p>
    </div>

    <div class="terceros-info" style="margin-top: 0; margin-bottom: 24px;">
        <div class="info-icon">
            <i class="fa-solid fa-circle-info"></i>
        </div>

        <div>
            <h3>Información</h3>
            <p>Las compras registran órdenes realizadas a proveedores.</p>
            <p>Cuando una compra se recepciona, el stock entra automáticamente al inventario.</p>
        </div>
    </div>

    <div class="terceros-card">

        <div class="card-top">
            <div>
                <h2>Lista de Compras</h2>
                <p>Registre órdenes de compra y recepcione mercadería al inventario</p>
            </div>

            <button type="button" class="btn-orange" onclick="abrirModalNuevaCompra()">
                <i class="fa-solid fa-plus"></i>
                Nueva Orden de Compra
            </button>
        </div>

        <div class="filters proveedores-filters">
            <div>
                <label>Buscar por N° Compra o Proveedor</label>
                <input id="buscarCompra" placeholder="Ej. OC-0001 / Comercial..." />
            </div>

            <div>
                <label>Estado</label>
                <select id="filtroEstadoCompra">
                    <option value="">-- Todos --</option>
                    <option value="Pendiente">Pendiente</option>
                    <option value="Recepcionado">Recepcionado</option>
                    <option value="Anulado">Anulado</option>
                </select>
            </div>

            <button type="button" class="btn-orange" onclick="filtrarCompras()">
                <i class="fa-solid fa-filter"></i> Filtrar
            </button>

            <button type="button" class="btn-reset" onclick="limpiarFiltrosCompras()">
                <i class="fa-solid fa-rotate-right"></i>
            </button>
        </div>

        <table id="tblCompras" class="display terceros-table" style="width:100%">
            <thead>
                <tr>
                    <th>N° COMPRA</th>
                    <th>PROVEEDOR</th>
                    <th>ALMACÉN</th>
                    <th>FECHA</th>
                    <th>SUBTOTAL</th>
                    <th>IGV</th>
                    <th>TOTAL</th>
                    <th>ESTADO</th>
                    <th>ACCIONES</th>
                </tr>
            </thead>
        </table>

    </div>



</div>

<div class="modal fade" id="modalCompra" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content modal-mp">

            <div class="modal-header">
                <h5 class="modal-title" id="tituloModalCompra">Nueva Orden de Compra</h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <form id="formCompra">
                <div class="modal-body">

                    <input type="hidden" id="id_compra" name="id_compra" value="0" />

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label>Proveedor</label>
                            <select id="id_proveedor"
                                    name="id_proveedor"
                                    class="form-control input-mp"
                                    required>
                                <option value="">Seleccione proveedor</option>
                            </select>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label>Almacén</label>
                            <select id="id_almacen"
                                    name="id_almacen"
                                    class="form-control input-mp"
                                    required>
                                <option value="">Seleccione almacén</option>
                            </select>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label>Observación</label>
                            <input id="observacion"
                                   name="observacion"
                                   class="form-control input-mp"
                                   maxlength="300"
                                   placeholder="Opcional" />
                        </div>
                    </div>

                    <hr />

                    <div class="row align-items-end">
                        <div class="col-md-5 mb-3">
                            <label>Producto</label>
                            <select id="productoCompra" class="form-control input-mp">
                                <option value="">Seleccione producto</option>
                            </select>
                        </div>

                        <div class="col-md-2 mb-3">
                            <label>Cantidad</label>
                            <input id="cantidadCompra"
                                   type="number"
                                   min="1"
                                   step="1"
                                   class="form-control input-mp" />
                        </div>

                        <div class="col-md-2 mb-3">
                            <label>Precio Costo</label>
                            <input id="precioCostoCompra"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   class="form-control input-mp" />
                        </div>

                        <div class="col-md-3 mb-3">
                            <button type="button" class="btn-orange w-100" onclick="agregarProductoCompra()">
                                <i class="fa-solid fa-cart-plus"></i>
                                Agregar Producto
                            </button>
                        </div>
                    </div>

                    <table class="table terceros-table" id="tblDetalleCompra">
                        <thead>
                            <tr>
                                <th>PRODUCTO</th>
                                <th>CANTIDAD</th>
                                <th>PRECIO COSTO</th>
                                <th>SUBTOTAL</th>
                                <th>ACCIÓN</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr id="filaSinProductos">
                                <td colspan="5" class="text-center text-muted">
                                    No hay productos agregados.
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="row justify-content-end mt-3">
                        <div class="col-md-4">
                            <div class="totales-compra">
                                <div>
                                    <span>Subtotal:</span>
                                    <strong id="subtotalCompra">S/ 0.00</strong>
                                </div>

                                <div>
                                    <span>IGV:</span>
                                    <strong id="igvCompra">S/ 0.00</strong>
                                </div>

                                <div>
                                    <span>Total:</span>
                                    <strong id="totalCompra">S/ 0.00</strong>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn-reset"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit" class="btn-orange">
                        Guardar Orden
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>