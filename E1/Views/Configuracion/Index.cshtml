@model E1.Models.Empresa
@{
    ViewData["Title"] = "Configuración del Sistema";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0" style="font-weight: 800; color: var(--text-primary);">Configuración</h1>
            <p class="text-muted mb-0">Gestione la información general de la empresa ficticia</p>
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 mb-4" style="background-color: rgba(16, 185, 129, 0.12); color: #10b981;" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["Mensaje"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card-module">
        <div class="card-module-header">
            <div>
                <h2>Datos de la Empresa</h2>
                <p>Esta información se imprimirá en los comprobantes de venta de MaquimPower</p>
            </div>
        </div>

        <form asp-action="Guardar" method="post" class="needs-validation" novalidate>
            <input type="hidden" asp-for="id_empresa" />

            <div class="row g-3">
                <!-- Nombre Comercial -->
                <div class="col-12 col-md-6">
                    <label asp-for="nombre" class="form-label">Nombre Comercial</label>
                    <div class="input-icon-wrapper">
                        <i class="fa-solid fa-building input-icon"></i>
                        <input class="form-control-custom" placeholder="Ej. MaquimPower S.A.C." value="@(Model?.nombre ?? "MaquimPower")" disabled style="opacity: 0.65; cursor: not-allowed;" />
                        <input type="hidden" asp-for="nombre" />
                    </div>
                    <span asp-validation-for="nombre" class="text-danger small"></span>
                </div>

                <!-- RUC -->
                <div class="col-12 col-md-6">
                    <label asp-for="ruc" class="form-label">RUC (Registro Único de Contribuyente)</label>
                    <div class="input-icon-wrapper">
                        <i class="fa-solid fa-id-card input-icon"></i>
                        <input asp-for="ruc" class="form-control-custom" placeholder="Ej. 20606853182" required maxlength="11" />
                    </div>
                    <span asp-validation-for="ruc" class="text-danger small"></span>
                </div>

                <!-- Dirección -->
                <div class="col-12">
                    <label asp-for="direccion" class="form-label">Dirección Fiscal</label>
                    <div class="input-icon-wrapper">
                        <i class="fa-solid fa-location-dot input-icon"></i>
                        <input asp-for="direccion" class="form-control-custom" placeholder="Ej. Av. Guanábana 112, Los Olivos, Lima" maxlength="200" />
                    </div>
                    <span asp-validation-for="direccion" class="text-danger small"></span>
                </div>

                <!-- Teléfono -->
                <div class="col-12 col-md-6">
                    <label asp-for="telefono" class="form-label">Teléfono de Contacto</label>
                    <div class="input-icon-wrapper">
                        <i class="fa-solid fa-phone input-icon"></i>
                        <input asp-for="telefono" class="form-control-custom" placeholder="Ej. 999999999" maxlength="15" />
                    </div>
                    <span asp-validation-for="telefono" class="text-danger small"></span>
                </div>

                <!-- Email -->
                <div class="col-12 col-md-6">
                    <label asp-for="email" class="form-label">Correo Electrónico</label>
                    <div class="input-icon-wrapper">
                        <i class="fa-solid fa-envelope input-icon"></i>
                        <input asp-for="email" type="email" class="form-control-custom" placeholder="Ej. contacto@maquimpower.com" maxlength="100" />
                    </div>
                    <span asp-validation-for="email" class="text-danger small"></span>
                </div>

                <!-- Logo URL -->
                <div class="col-12">
                    <label asp-for="logo_url" class="form-label">URL del Logotipo</label>
                    <div class="input-icon-wrapper">
                        <i class="fa-solid fa-image input-icon"></i>
                        <input asp-for="logo_url" class="form-control-custom" placeholder="Ej. https://url-de-tu-logo.png" maxlength="300" />
                    </div>
                    <span asp-validation-for="logo_url" class="text-danger small"></span>
                </div>
            </div>

            <div class="mt-4 text-end">
                <button type="submit" class="btn-primary-mp px-4 py-2">
                    <i class="fa-solid fa-floppy-disk"></i> Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
