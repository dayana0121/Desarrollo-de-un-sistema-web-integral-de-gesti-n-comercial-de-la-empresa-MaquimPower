@{
    ViewData["Title"] = "Gestión de Categorías";
    var categorias = ViewBag.Categorias as List<E1.Models.Categoria> ?? new List<E1.Models.Categoria>();
}

<div class="terceros-page">
    <div class="terceros-header">
        <h1>Productos</h1>
        <p>Gestione el catálogo de categorías, marcas, proveedores y productos</p>
    </div>

    <!-- Navigation Tabs -->
    <div class="terceros-tabs">
        <a href="/Productos" class="tab"><i class="fa-solid fa-box"></i> Productos</a>
        <a href="/Productos/Categorias" class="tab active"><i class="fa-solid fa-tags"></i> Categorías</a>
        <a href="/Productos/Marcas" class="tab"><i class="fa-solid fa-trademark"></i> Marcas</a>
    </div>

    <!-- Card Module -->
    <div class="terceros-card">
        <div class="card-module-header">
            <div>
                <h2>Categorías de Productos</h2>
                <p>Clasifique sus productos para facilitar la búsqueda e inventario</p>
            </div>
            <button class="btn-primary-mp" data-bs-toggle="modal" data-bs-target="#modalCrearCategoria">
                <i class="fa-solid fa-plus"></i> Nueva Categoría
            </button>
        </div>

        <!-- Filtros de búsqueda a nivel de controlador -->
        <form method="get" action="/Productos/Categorias" class="row g-3 mb-4 align-items-end">
            <div class="col-12 col-md-6 col-lg-4">
                <label class="form-label">Buscar Categoría</label>
                <input type="text" name="busqueda" class="form-control" value="@ViewBag.Busqueda" placeholder="Nombre o código..." autocomplete="off" />
            </div>
            <div class="col-12 col-md-3">
                <button type="submit" class="btn-primary-mp w-100">
                    <i class="fa-solid fa-filter"></i> Filtrar
                </button>
            </div>
        </form>

        <div class="table-responsive">
            <table id="tblCategorias" class="table table-hover align-middle w-100">
                <thead>
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th style="width: 150px;">Código</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                        <th style="width: 100px;" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in categorias)
                    {
                        <tr>
                            <td>@c.id_categoria</td>
                            <td><code style="color: var(--accent);">@c.codigo</code></td>
                            <td>@c.nombre</td>
                            <td class="text-muted small">@(c.descripcion ?? "-")</td>
                            <td>
                                @if (c.estado)
                                {
                                    <span class="badge-active">Activa</span>
                                }
                                else
                                {
                                    <span class="badge-inactive">Inactiva</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="action-btn btn-edit me-1" 
                                        onclick="editarCategoria(@c.id_categoria, '@c.codigo', '@c.nombre', '@c.descripcion', @(c.estado ? "true" : "false"))">
                                    <i class="fa-solid fa-pen"></i>
                                </button>
                                <button class="action-btn btn-delete" onclick="eliminarCategoria(@c.id_categoria, '@c.nombre')">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Crear Categoría -->
<div class="modal fade" id="modalCrearCategoria" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-tag text-warning me-2"></i> Crear Nueva Categoría</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="frmCrearCategoria">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Código Único</label>
                        <input type="text" name="codigo" class="form-control" placeholder="Ej. LUBR" required maxlength="20" autocomplete="off" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nombre de la Categoría</label>
                        <input type="text" name="nombre" class="form-control" placeholder="Ej. Lubricantes" required maxlength="100" autocomplete="off" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Descripción (Opcional)</label>
                        <textarea name="descripcion" class="form-control" placeholder="Detalle sobre qué tipo de productos almacena..." rows="3" maxlength="200"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary-mp" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn-primary-mp">Crear Categoría</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Editar Categoría -->
<div class="modal fade" id="modalEditarCategoria" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-pen text-warning me-2"></i> Editar Categoría</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="frmEditarCategoria">
                <input type="hidden" name="id_categoria" id="edit_id_categoria" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Código Único</label>
                        <input type="text" name="codigo" id="edit_codigo" class="form-control" required maxlength="20" autocomplete="off" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nombre de la Categoría</label>
                        <input type="text" name="nombre" id="edit_nombre" class="form-control" required maxlength="100" autocomplete="off" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <textarea name="descripcion" id="edit_descripcion" class="form-control" rows="3" maxlength="200"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Estado</label>
                        <select name="estado" id="edit_estado" class="form-select">
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary-mp" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn-primary-mp">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#tblCategorias').DataTable({
                dom: '<"d-flex justify-content-between align-items-center mb-3"l>rtip'
            });

            // Submit Crear Categoría
            $('#frmCrearCategoria').on('submit', function(e) {
                e.preventDefault();
                $.ajax({
                    url: '/Productos/CrearCategoria',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function(res) {
                        if (res.ok) {
                            $('#modalCrearCategoria').modal('hide');
                            showAlert(res.msg || 'Categoría creada correctamente', 'success');
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            showAlert(res.msg, 'error');
                        }
                    },
                    error: function() {
                        showAlert('Error en la comunicación con el servidor', 'error');
                    }
                });
            });

            // Submit Editar Categoría
            $('#frmEditarCategoria').on('submit', function(e) {
                e.preventDefault();
                $.ajax({
                    url: '/Productos/ActualizarCategoria',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function(res) {
                        if (res.ok) {
                            $('#modalEditarCategoria').modal('hide');
                            showAlert(res.msg || 'Categoría actualizada correctamente', 'success');
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            showAlert(res.msg, 'error');
                        }
                    },
                    error: function() {
                        showAlert('Error en la comunicación con el servidor', 'error');
                    }
                });
            });
        });

        function editarCategoria(id, codigo, nombre, desc, estado) {
            $('#edit_id_categoria').val(id);
            $('#edit_codigo').val(codigo);
            $('#edit_nombre').val(nombre);
            $('#edit_descripcion').val(desc);
            $('#edit_estado').val(estado.toString());
            $('#modalEditarCategoria').modal('show');
        }

        function eliminarCategoria(id, nombre) {
            if (confirm(`¿Está seguro de que desea desactivar la categoría "${nombre}"?`)) {
                $.ajax({
                    url: '/Productos/EliminarCategoria',
                    type: 'POST',
                    data: { id: id },
                    success: function(res) {
                        if (res.ok) {
                            showAlert(res.msg || 'Categoría desactivada correctamente', 'success');
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            showAlert(res.msg || 'No se pudo desactivar la categoría', 'error');
                        }
                    },
                    error: function() {
                        showAlert('Error al procesar la solicitud', 'error');
                    }
                });
            }
        }
    </script>
}
