@{
    ViewData["Title"] = "Detalle de Venta";
    var venta = ViewBag.Venta as E1.Models.Venta;
    var detalle = ViewBag.Detalle as List<E1.Models.DetalleVenta> ?? new List<E1.Models.DetalleVenta>();
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0" style="font-weight:800;color:var(--text-primary);">
                Detalle de Venta
            </h1>
            <p class="text-muted mb-0">Información completa de la transacción</p>
        </div>
        <div class="d-flex gap-2">
            @if (venta != null && venta.EstadoVenta?.codigo != "ANUL")
            {
                <button class="btn-secondary-mp" style="background:#ef444422;color:#ef4444;border:1px solid #ef444444;" onclick="anularVenta(@venta.id_venta)">
                    <i class="fa-solid fa-ban me-1"></i>Anular
                </button>
            }
            <a href="/Ventas/Historial" class="btn-secondary-mp">
                <i class="fa-solid fa-arrow-left me-1"></i>Volver
            </a>
        </div>
    </div>

    @if (venta == null)
    {
        <div class="card-module p-4 text-center text-muted">Venta no encontrada.</div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="card-module">
                    <div class="card-module-header">
                        <div><h2>Datos de la Venta</h2></div>
                    </div>
                    <div class="p-3">
                        <table class="table table-sm mb-0">
                            <tr><td class="text-muted">N° Venta</td><td><code style="color:var(--accent);">@venta.numero_venta</code></td></tr>
                            <tr><td class="text-muted">Comprobante</td><td>@venta.tipo_comprobante</td></tr>
                            <tr><td class="text-muted">Método de pago</td><td>@venta.metodo_pago</td></tr>
                            <tr><td class="text-muted">Fecha</td><td>@venta.fecha_venta.ToString("dd/MM/yyyy HH:mm")</td></tr>
                            <tr>
                                <td class="text-muted">Estado</td>
                                <td>
                                    @if (venta.EstadoVenta?.codigo == "ANUL")
                                    {
                                        <span class="badge-inactive">Anulada</span>
                                    }
                                    else
                                    {
                                        <span class="badge-active">@venta.EstadoVenta?.nombre</span>
                                    }
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card-module">
                    <div class="card-module-header">
                        <div><h2>Cliente y Totales</h2></div>
                    </div>
                    <div class="p-3">
                        <table class="table table-sm mb-0">
                            <tr><td class="text-muted">Cliente</td><td>@venta.Cliente?.nombre_completo</td></tr>
                            @if (!string.IsNullOrEmpty(venta.tipo_documento_cli))
                            {
                                <tr><td class="text-muted">@venta.tipo_documento_cli</td><td>@venta.numero_documento_cli</td></tr>
                            }
                            <tr><td class="text-muted">Subtotal</td><td class="text-end">S/ @venta.subtotal.ToString("N2")</td></tr>
                            <tr><td class="text-muted">Descuento</td><td class="text-end" style="color:#ef4444;">- S/ @venta.descuento.ToString("N2")</td></tr>
                            <tr><td class="text-muted">IGV (18%)</td><td class="text-end">S/ @venta.igv.ToString("N2")</td></tr>
                            <tr>
                                <td class="fw-bold">TOTAL</td>
                                <td class="text-end fw-bold fs-5" style="color:#22c55e;">S/ @venta.total.ToString("N2")</td>
                            </tr>
                            <tr><td class="text-muted">Pagado</td><td class="text-end">S/ @venta.monto_pagado.ToString("N2")</td></tr>
                            <tr><td class="text-muted">Vuelto</td><td class="text-end">S/ @venta.vuelto.ToString("N2")</td></tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-module">
            <div class="card-module-header">
                <div><h2>Productos</h2><p>Detalle de ítems de la venta</p></div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle w-100">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>SKU</th>
                            <th class="text-center">Cantidad</th>
                            <th class="text-end">Precio Unit.</th>
                            <th class="text-end">Descuento</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in detalle)
                        {
                            <tr>
                                <td>@d.Producto?.nombre</td>
                                <td><code style="color:var(--accent);">@d.Producto?.sku</code></td>
                                <td class="text-center">@d.cantidad</td>
                                <td class="text-end">S/ @d.precio_unitario.ToString("N2")</td>
                                <td class="text-end" style="color:#ef4444;">S/ @d.descuento.ToString("N2")</td>
                                <td class="text-end fw-semibold">S/ @d.subtotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        async function anularVenta(id) {
            if (!confirm('¿Anular esta venta? Se devolverá el stock automáticamente.')) return;
            const res = await fetch('/Ventas/Anular', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'id_venta=' + id
            });
            const data = await res.json();
            if (data.ok) { showAlert(data.msg, 'success'); setTimeout(() => location.reload(), 800); }
            else showAlert('Error: ' + data.msg, 'error');
        }
    </script>
}